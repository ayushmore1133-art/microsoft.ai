# =============================================================================
# Pick your provider: "groq", "gemini", or "anthropic".
# "groq" and "gemini" both have genuinely free, no-credit-card API tiers.
# Groq's free tier (30 req/min) runs this app's multi-agent pipeline much
# faster than Gemini's free tier (5 req/min), so it's the default here.
# "anthropic" needs a paid key or its one-time ~$5 free trial credit.
# =============================================================================
LLM_PROVIDER=groq

# ---- Groq (free, fast) -------------------------------------------------------
# Get a free key with just an email/Google login, no card: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Gemini (free, but a slower/lower daily limit) --------------------------
# Get a free key with just a Google account, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash

# ---- Anthropic (only needed if LLM_PROVIDER=anthropic) ----------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# ---- Server -------------------------------------------------------------
PORT=3000
MAX_TOKENS=2400
